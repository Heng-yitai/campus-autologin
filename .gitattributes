# 统一换行符，避免 Windows / macOS / Linux 之间互相改行尾
* text=auto eol=lf

# Shell 脚本必须是 LF，否则 bash 报 "$'\r': command not found"
*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.java  text eol=lf
*.xml   text eol=lf

# Windows 批处理与 VBScript 必须是 CRLF
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.vbs   text eol=crlf

# 中文 .cmd 存的是 GBK，别当文本处理（会被当成二进制差异或乱码）
打包exe.cmd binary

# 二进制文件不要做任何转换
*.png   binary
*.ico   binary
*.jpg   binary
*.zip   binary
*.jks   binary
